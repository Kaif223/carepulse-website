# Copy to .env.local for local work. On Vercel, set these in Project Settings →
# Environment Variables. `pnpm build` refuses to run without a valid production
# configuration (rules in src/lib/site-env.ts); `pnpm dev` needs none of them.

# REQUIRED in production. The public https origin: canonical URLs, sitemap,
# robots and Open Graph. No localhost, no placeholder, no trailing path.
# (Vercel preview deployments fall back to their own URL and are noindexed.)
NEXT_PUBLIC_SITE_URL=

# AT LEAST ONE of the next two is REQUIRED in production — the page must have
# a real call to action. Leave a value empty and its link is simply not shown.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_APP_URL=

# LOCAL TESTING ONLY. Lets `pnpm build` accept a localhost origin (the
# Playwright suite sets this itself). Never set it on a deployment.
# SITE_URL_ALLOW_LOCAL=1
