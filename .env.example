# Public origin of this marketing site. Used for canonical URLs, the sitemap,
# robots.txt and Open Graph metadata. Must be set for production builds.
NEXT_PUBLIC_SITE_URL=https://carepulse.example

# Optional. When set, a "Sign in" link to the CarePulse application appears in
# the navigation. Leave empty to hide it — the site never renders a dead link.
NEXT_PUBLIC_APP_URL=

# Optional. When set, the final call to action becomes "Talk to us" (mailto).
# Leave empty and the CTA falls back to exploring the product on this page.
NEXT_PUBLIC_CONTACT_EMAIL=
